# Runtime secrets for the Unraid container.
#
# Copy to /mnt/user/appdata/dev-social/.env on the host, fill in, chmod 600.
# Never commit the real file — .gitignore covers .env*, and this image is the
# only thing that ever sees these values.
#
# Everything non-secret (ports, public origin, SUPABASE_URL) lives in
# docker-compose.yml instead, so this file stays short enough to audit.

# Server-side Supabase access: leaderboard writes and photo uploads. Without it
# the app still runs, but entirely in memory — no persistence, no photo storage.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side Google Maps key for Real GeoGuessr panorama resolution
# (Street View Static API). Must be UNRESTRICTED — it is called server-to-server,
# so an HTTP-referrer restriction will reject it.
#
# This is a different key from NEXT_PUBLIC_GOOGLE_MAPS_API_KEY, which is baked
# into the browser bundle at build time by CI and must be referrer-restricted.
# Optional: leave blank if panoIds are pre-baked into server/geoLocations.ts.
GOOGLE_MAPS_API_KEY=
